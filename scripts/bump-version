#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: $0 <version>" >&2
    exit 2
fi

VERSION="${1#v}"
if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; then
    echo "version must be valid SemVer (for example: 0.3.0 or 0.3.0-rc.1)" >&2
    exit 2
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

perl -0pi -e "s/^version: .*/version: $VERSION/m; s/^appVersion: \"[^\"]+\"/appVersion: \"$VERSION\"/m" charts/waxdemon/Chart.yaml
perl -0pi -e "s/(--version )\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?/\${1}$VERSION/g" README.md

echo "Updated Helm and README release metadata to $VERSION."
